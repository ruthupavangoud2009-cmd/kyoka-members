# ==============================================================================
# DISCORD BOT CREDENTIALS
# ==============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
BOT_PREFIX=!
# Comma-separated list of Discord user IDs allowed to run commands (e.g. 123456789012345678)
# If empty, all users in the server can run commands.
ADMIN_USER_IDS=

# ==============================================================================
# RENDER 24/7 HOSTING SETTINGS
# ==============================================================================
PORT=8080
# Your public Render URL (e.g. https://nexuver-bot.onrender.com) for self-ping keep-alive
RENDER_EXTERNAL_URL=
# Ping interval in seconds (default: 300 = every 5 minutes)
KEEP_ALIVE_INTERVAL=300

# ==============================================================================
# ACCOUNT GENERATOR (MOONGEN / EVS) SETTINGS (Optional Overrides)
# ==============================================================================
GEN_EMAIL_PROVIDER=afhamxmailz
AFHAMXMAILZ_KEY=axm_z6ae2hPmHG6eUq33lauErJqYTZeY3zRPNuDvepY4Zas
NINECAPTCHA_KEY=9cap-8a70873a-b3e7-45b6-bbcb-5c8f63782e49
NOPECHA_KEY=

# ==============================================================================
# PHONE UNLOCKER SETTINGS (Optional Overrides)
# ==============================================================================
# Phone service: 5sim | smsbower | herosms | tigersms
PHONE_SERVICE=5sim
FIVESIM_KEY=
SMSBOWER_KEY=
HEROSMS_KEY=
TIGERSMS_KEY=

# Captcha solver: onyx | hcaptchasolver | voidsolver
CAPTCHA_SOLVER=onyx
ONYX_KEY=
HCAPTCHASOLVER_KEY=

